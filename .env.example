VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=http://localhost:5000/api/orders/payments/vnpay/return
VNPAY_EXCHANGE_RATE=27000
VNPAY_LOCALE=vn
VNPAY_DEBUG=false
