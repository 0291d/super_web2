PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/brew
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=change-me

# VNPay sandbox. Fill these with merchant sandbox credentials from VNPay.
